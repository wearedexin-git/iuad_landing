# ============================================
# IUAD Landing - Configurazione Ambiente
# ============================================
# Copia questo file in .env e compila con i valori reali

# ── API Eduarth ─────────────────────────────
# Impostare su 'staging' o 'production'
API_ENVIRONMENT=production

# Token JWT Staging (per sviluppo/test)
API_TOKEN_STAGING=your_staging_jwt_token_here

# Token JWT Production (per produzione)
API_TOKEN_PRODUCTION=your_production_jwt_token_here

# ── Configurazione Email ────────────────────
# Email mittente per le notifiche
EMAIL_FROM=contact@accademiamoda.it
EMAIL_FROM_NAME=Accademia IUAD

# Email destinatario per notifiche interne
EMAIL_TO_ACADEMY=ufficioculturale@accademiamoda.it
