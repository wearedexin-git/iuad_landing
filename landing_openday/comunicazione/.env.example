# Configurazione ambiente API
# production | staging
API_ENVIRONMENT=staging

# Token API per ambiente staging
API_TOKEN_STAGING=INSERISCI_TOKEN_STAGING_EDUARTH

# Token API per ambiente production
API_TOKEN_PRODUCTION=INSERISCI_TOKEN_PRODUCTION_EDUARTH

# Configurazione Email
EMAIL_FROM=contact@accademiamoda.it
EMAIL_FROM_NAME=Accademia IUAD
EMAIL_TO_ACADEMY=ufficioculturale@accademiamoda.it

# Note:
# 1. Copia questo file in .env nella root del progetto (cartella comunicazione/)
# 2. Sostituisci i valori con quelli reali
# 3. NON committare il file .env su Git (è già nel .gitignore)
# Sedi, date Open Day e testi footer: src/app/config/openday-config.json (non nel .env)
